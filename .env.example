# Existing resume parser / authentication settings
GEMINI_API_KEY=
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_MODEL=gemini-3.6-flash
DATABASE_URL=sqlite:///./resume_parser.db

# Milestone 2 internship RAG settings
# "local" uses deterministic, persisted feature-hashing embeddings and needs no extra service.
# Set to "gemini" to use Gemini embeddings with GEMINI_API_KEY.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=gemini-embedding-001
INTERNSHIP_DATASET_PATH=data/internships.json
INTERNSHIP_INDEX_PATH=data/internship_vector_index.json
INTERNSHIP_CHUNK_SIZE=850
VECTOR_DIMENSIONS=384
PRODUCT_KNOWLEDGE_PATH=data/product_knowledge.json
